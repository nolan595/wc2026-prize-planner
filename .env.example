# ──────────────────────────────────────────────────────────────────────────────
# WC 2026 F2P Prize Planner — environment variables
#
# Copy this file to .env.local and fill in the values.
# .env.local is in .gitignore and must never be committed.
# ──────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string.
# In Railway: Project → your Postgres service → Connect → copy the
# "Postgres Connection URL". It looks like:
#   postgresql://postgres:<password>@<host>.railway.app:5432/<db>?sslmode=require
#
# Required: yes
# Used by: Prisma (server-side only — never exposed to the browser)
DATABASE_URL="postgresql://user:password@host:5432/world_cup_planner?sslmode=require"
